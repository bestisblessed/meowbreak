{
  "manifest_version": 3,
  "name": "MeowBreak",
  "version": "1.0.0",
  "description": "A cat-powered Chrome break timer that nudges you away from endless browsing.",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/meowbreak-icon16.png",
    "48": "assets/meowbreak-icon48.png",
    "128": "assets/meowbreak-icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeowBreak",
    "default_icon": {
      "16": "assets/meowbreak-icon16.png",
      "48": "assets/meowbreak-icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
